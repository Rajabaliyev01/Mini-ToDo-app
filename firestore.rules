rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Todos kolleksiyasi uchun qoidalar
    match /todos/{todoId} {
      // Hozircha ommaviy o'qish va yozishga ruxsat
      // Kelgusida Auth qo'shilganda: allow read, write: if request.auth != null;
      allow read, write: if true;
    }
  }
}
